		<!--ASSERT -->
<axsl:choose>
      <axsl:when test="((sum(MTR:SA105/MTR:PropertyIncomeAndExpenses/MTR:PropertyIncomeAllowance) + sum(MTR:SA106/MTR:OverseasLandAndPropertyIncomeDetails/MTR:PropertyIncomeAllowance)) - (1000) &lt; 0.001)"/>
      <axsl:otherwise>
