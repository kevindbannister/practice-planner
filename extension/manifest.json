{
  "manifest_version": 3,
  "name": "XProFlow Jobs",
  "version": "0.1.0",
  "description": "A side panel for XProFlow: the open jobs for the client on the page you're looking at, and a job timer.",
  "key": "",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "XProFlow jobs and timer",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "identity",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://*.xero.com/*",
    "https://graph.microsoft.com/*",
    "https://login.microsoftonline.com/*"
  ]
}